# Portainer connection
# Use https://host:9443 for the default HTTPS port, http://host:9000 for HTTP
PORTAINER_URL=https://localhost:9443

# Portainer API key (generate from My Account → API Keys in Portainer UI)
PORTAINER_API_KEY=

# TLS verification — set to "false" for self-signed certs (common in home
# Portainer setups). Defaults to true (verify) when unset.
PORTAINER_VERIFY_TLS=false
